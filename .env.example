# Copie este arquivo para ".env" e preencha com seus dados reais.
# Sem as variáveis de e-mail/Twilio, o app funciona normalmente, só não
# envia notificações (elas aparecem no console do servidor).

# Usuário e senha do painel dos noivos (/admin). Obrigatório — sem isso
# o painel fica bloqueado.
ADMIN_USER=
ADMIN_PASSWORD=

# Banco de dados (Supabase, gratuito) — IMPORTANTE em produção.
# Sem isso, os convites são salvos num arquivo local que se PERDE a cada
# deploy (disco não-permanente do Render). Crie um projeto grátis em
# https://supabase.com, rode o SQL abaixo no "SQL Editor" do projeto, e
# pegue a URL e a "service_role key" em Project Settings > API.
#
# create table app_dados (
#   chave text primary key,
#   valor jsonb not null default '[]'::jsonb
# );
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Notificação por e-mail (gratuita, via Gmail).
# EMAIL_USER: o gmail que vai ENVIAR as notificações.
# EMAIL_PASSWORD: uma "senha de app" do Google (não é a senha normal da conta) —
#   gere em https://myaccount.google.com/apppasswords (precisa da verificação
#   em duas etapas ativada na conta Google).
# COUPLE_EMAILS: e-mails que devem RECEBER as notificações, separados por vírgula.
EMAIL_USER=
EMAIL_PASSWORD=
COUPLE_EMAILS=

# Notificação por SMS (opcional, pago — via Twilio: https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# Telefones dos noivos que devem receber o SMS, separados por vírgula
# Formato internacional E.164, ex: +5511999998888
COUPLE_PHONE_NUMBERS=
